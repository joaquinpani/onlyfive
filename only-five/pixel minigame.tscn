[sub_resource type="GDScript" id="GDScript_nho35"]
script/source = "extends CharacterBody2D
@export var velocidad: int = 200
var muerto = false

func _physics_process(delta: float) -> void:
	if muerto == false:
		var dirrecion = Vector2.ZERO
		
		if Input.is_action_pressed(\"adelante_pixel\"):
			dirrecion.y -= 1
		if Input.is_action_pressed(\"abajo_pixel\"):
			dirrecion.y += 1
		if Input.is_action_pressed(\"izquierda_pixel\"):
			dirrecion.x -= 1
		if Input.is_action_pressed(\"arriba_pixel\"): 
			dirrecion.x += 1
			
		dirrecion = dirrecion.normalized()
		velocity = dirrecion * velocidad
		
		if dirrecion != Vector2.ZERO:
			$AnimatedSprite2D.play(\"walk\")
			if dirrecion.x != 0:
				$AnimatedSprite2D.flip_h = dirrecion.x < 0
		else:
			$AnimatedSprite2D.play(\"idle\")
			
		move_and_slide()




func _on_area_2d_body_entered(body: Node2D) -> void:
		
	
	if body.is_in_group(\"player_p\"):
		$AnimatedSprite2D.play(\"die\")
		$Timer.start()
		muerto = true
	pass # Replace with function body.


func _on_timer_timeout() -> void:
	position = Vector2(1387,315)
	muerto = false
	pass # Replace with function body.





func _on_cambio_2_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		$\"../Camera2D2\".make_current()
	pass # Replace with function body.


func _on_cambio_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		$\"../Camera2D\".make_current()


func _on_cambio_4_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		$\"../Camera2D3\".make_current()
	pass # Replace with function body.


func _on_cambio_6_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		$\"../Camera2D4\".make_current()
	pass # Replace with function body.


func _on_cambio_5_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		$\"../Camera2D3\".make_current()
	pass # Replace with function body.


func _on_cambio_8_body_entered(body: Node2D) -> void:
	if body.is_in_group(\"player_p\"):
		
	pass # Replace with function body.
"

