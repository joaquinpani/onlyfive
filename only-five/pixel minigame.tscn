resource_name = "palanca_píxel_1"
script/source = "extends AnimatableBody2D

func _process(delta: float) -> void:
	if $Area2D.has_overlapping_bodies() and Input.is_action_pressed(\"interactuar_pixel\"):
		$AnimatedSprite2D.play(\"abajo\")
		$\"../AnimatableBody2D18/AnimationPlayer\".play(\"pared\")
		
"

